<?xml version="1.0"?>
<!--
  Authored, mesh-free six-axis demo robot for the public toolkit.
  Dimensions are intentionally generic and do not reproduce a vendor model.
-->
<robot name="demo_six_axis">
  <material name="blue">
    <color rgba="0.12 0.35 0.78 1.0"/>
  </material>
  <material name="light_blue">
    <color rgba="0.35 0.62 0.95 1.0"/>
  </material>
  <material name="tool_gray">
    <color rgba="0.72 0.74 0.78 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="2.0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.18" length="0.10"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.18" length="0.10"/></geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="0 0 0.10"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><cylinder radius="0.12" length="0.20"/></geometry>
      <material name="light_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10"/>
      <geometry><cylinder radius="0.12" length="0.20"/></geometry>
    </collision>
  </link>

  <link name="upper_arm_link">
    <inertial>
      <origin xyz="0.18 0 0"/>
      <mass value="1.2"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/>
    </inertial>
    <visual>
      <origin xyz="0.18 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.07" length="0.36"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.18 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.07" length="0.36"/></geometry>
    </collision>
  </link>

  <link name="forearm_link">
    <inertial>
      <origin xyz="0.16 0 0"/>
      <mass value="0.9"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.015" iyz="0" izz="0.015"/>
    </inertial>
    <visual>
      <origin xyz="0.16 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.055" length="0.32"/></geometry>
      <material name="light_blue"/>
    </visual>
    <collision>
      <origin xyz="0.16 0 0" rpy="0 1.5708 0"/>
      <geometry><cylinder radius="0.055" length="0.32"/></geometry>
    </collision>
  </link>

  <link name="wrist_1_link">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.5"/>
      <inertia ixx="0.008" ixy="0" ixz="0" iyy="0.008" iyz="0" izz="0.008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.065" length="0.10"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.065" length="0.10"/></geometry>
    </collision>
  </link>

  <link name="wrist_2_link">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.4"/>
      <inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.006"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.055" length="0.10"/></geometry>
      <material name="light_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.055" length="0.10"/></geometry>
    </collision>
  </link>

  <link name="wrist_3_link">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="0.3"/>
      <inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.004"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.045" length="0.10"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.045" length="0.10"/></geometry>
    </collision>
  </link>

  <link name="tool0">
    <inertial>
      <origin xyz="0 0 0.06"/>
      <mass value="0.2"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.06"/>
      <geometry><cylinder radius="0.035" length="0.12"/></geometry>
      <material name="tool_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.06"/>
      <geometry><cylinder radius="0.035" length="0.12"/></geometry>
    </collision>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="shoulder_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="20" velocity="2.0"/>
  </joint>
  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link"/><child link="upper_arm_link"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="20" velocity="2.0"/>
  </joint>
  <joint name="joint_3" type="revolute">
    <parent link="upper_arm_link"/><child link="forearm_link"/>
    <origin xyz="0.36 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.3562" upper="2.3562" effort="15" velocity="2.5"/>
  </joint>
  <joint name="joint_4" type="revolute">
    <parent link="forearm_link"/><child link="wrist_1_link"/>
    <origin xyz="0.32 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="3.0"/>
  </joint>
  <joint name="joint_5" type="revolute">
    <parent link="wrist_1_link"/><child link="wrist_2_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="8" velocity="3.0"/>
  </joint>
  <joint name="joint_6" type="revolute">
    <parent link="wrist_2_link"/><child link="wrist_3_link"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-3.14159" upper="3.14159" effort="6" velocity="3.0"/>
  </joint>
  <joint name="tool0_fixed" type="fixed">
    <parent link="wrist_3_link"/><child link="tool0"/>
    <origin xyz="0 0 0.10" rpy="0 0 0"/>
  </joint>
</robot>
